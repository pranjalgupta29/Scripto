# Copy to .env and fill in. Every value is read via scripto.config.Settings.

DATABASE_URL=postgresql+psycopg://scripto:scripto@localhost:5433/scripto
JWT_SECRET=dev-only-change-me

# --- blob storage ---
BLOB_BACKEND=local
BLOB_LOCAL_ROOT=./var/blobs
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- llm: fake | anthropic | openai_compatible ---
LLM_PROVIDER=fake
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_EXTRACT_MODEL=claude-haiku-4-5
LLM_COMPOSE_MODEL=claude-opus-5
LLM_RANK_MODEL=claude-haiku-4-5

# --- embeddings: fake | voyage | openai ---
EMBEDDING_PROVIDER=fake
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# --- web discovery: fake | duckduckgo | exa | tavily ---
# duckduckgo needs no key and no card. Unofficial and rate limited, but real.
SEARCH_PROVIDER=duckduckgo
# SEARCH_API_KEY=          # only needed for exa / tavily

# --- hard spend ceilings, enforced in code before any billable call ---
# 0 disables a provider outright; -1 is unlimited. Start low.
BUDGET_SEARCH_CALLS_PER_MONTH=300
BUDGET_LLM_CALLS_PER_MONTH=2000
BUDGET_EMBEDDING_CALLS_PER_MONTH=500

CORS_ORIGINS=http://localhost:3000
